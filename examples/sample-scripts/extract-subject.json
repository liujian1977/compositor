{
    "description": "Extract a subject from an image and save as transparent PNG",
    "steps": [
        {
            "command": "compositor extract",
            "args": {
                "--input": "./photo.jpg",
                "--model": "vision",
                "--refine-radius": 3,
                "--contrast-threshold": 0.75,
                "--edge-shift": -1,
                "--output": "./subject_mask.png"
            },
            "expected_status": "success"
        },
        {
            "command": "compositor cutout",
            "args": {
                "--image": "./photo.jpg",
                "--mask": "./subject_mask.png",
                "--output": "./subject.png"
            },
            "expected_status": "success",
            "notes": "Apply the mask as straight RGBA alpha. `compositor apply-mask` is the same command."
        }
    ]
}
